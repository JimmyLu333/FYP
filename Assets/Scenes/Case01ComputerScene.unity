      m_Calls: []
  m_text: "\u59D3\u540D\uFF1A\u5218\u798F\u6765\n\u5E74\u9F84\uFF1A65\u5C81\n\u8EAB\u4EFD\uFF1A\u5C45\u4F4F\u5728\u6CE2\u6F9C\u5E02\uFF0C\u9000\u4F11\u8001\u4EBA\uFF0C\u5728\u5BB6\u7167\u987E\u5B59\u5B50\n\u7535\u8BDD\uFF1A13228865437\n\n\u57FA\u672C\u80CC\u666F\uFF1A\n-
    \u521A\u83B7\u5F97\u4E00\u7B14\u62C6\u8FC1\u8865\u507F\u6B3E\uFF0C\u8D26\u6237\u8D44\u91D1\u5145\u8DB3\n-
    \u5BB6\u5EAD\u7ED3\u6784\u8F83\u5355\u4E00\uFF0C\u4E0E\u5B59\u5B50\u5173\u7CFB\u5BC6\u5207\n-
    \u65E5\u5E38\u751F\u6D3B\u4EE5\u5BB6\u5EAD\u4E3A\u4E2D\u5FC3\uFF0C\u793E\u4EA4\u5708\u8F83\u7A84\n\n\u53EF\u5229\u7528\u4FE1\u606F\uFF1A\n-
    \u9AD8\u5EA6\u6EBA\u7231\u5B59\u5B50\uFF0C\u662F\u4E3B\u8981\u60C5\u611F\u4F9D\u8D56\u5BF9\u8C61\n-
    \u5BF9\u201C\u5B59\u5B50\u76F8\u5173\u4FE1\u606F\u201D\u53CD\u5E94\u6781\u5176\u654F\u611F\n-
    \u9762\u5BF9\u7A81\u53D1\u72B6\u51B5\u5BB9\u6613\u4EA7\u751F\u5F3A\u70C8\u7126\u8651\u548C\u6050\u614C\n\n\u4EFB\u52A1\u76EE\u6807\uFF1A\n1.
    \u5047\u88C5\u533B\u9662\u544A\u77E5\u5176\u5B59\u5B50\u5377\u5165\u8F66\u7978\n2.
    \u544A\u8BC9\u4ED6\u60C5\u51B5\u975E\u5E38\u7D27\u6025\uFF0C\u9700\u8981\u4ED6\u7ACB\u523B\u6C47\u6B3E\n3.
    \u9700\u8981\u4ED6\u7ACB\u523B\u524D\u5F80\u6700\u8FD1\u7684\u94F6\u884CATM\u5C06\u6C47\u6B3E\u6C47\u5165\u533B\u9662\u7279\u522B\u901A\u9053\u8D26\u6237\n3.
    \u83B7\u53D6\u4ED6\u6536\u5230\u7684\u9A8C\u8BC1\u7801\n4. \u7834\u89E3\u9632\u706B\u5899\n5.
    \u4EFB\u52A1\u5B8C\u6210"
