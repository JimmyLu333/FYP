  playerName: "\u9648\u5927\u592B"
  npcName: "\u5218\u798F\u6765"
  autoActorName: PlayerAutoActor
  displayNameForAutoActor: "\u9648\u5927\u592B"
  npcReplyDelay: 1.2
  scamRateText: {fileID: 352817131}
  maxScamRate: 100
  resetScamRateOnStart: 1
  choiceScoreRules:
  - choiceText: "\u5582\uFF0C\u60A8\u597D\uFF0C\u8BF7\u95EE\u662F\u5218\u798F\u6765\u8001\u5148\u751F\u5417\uFF1F"
    scoreGain: 5
  - choiceText: "\u738B\u7237\u7237\u60A8\u597D\uFF0C\u6211\u662F\u6CE2\u6F9C\u5E02\u4EBA\u6C11\u533B\u9662\u6025\u8BCA\u79D1\u7684\u9648\u4E3B\u4EFB\u3002"
    scoreGain: 15
  - choiceText: "\u738B\u7237\u7237\u60A8\u597D\uFF0C\u6211\u662F\u5927\u6797\u5E02\u4EBA\u6C11\u533B\u9662\u6025\u8BCA\u79D1\u7684\u9648\u4E3B\u4EFB\u3002"
    scoreGain: -5
  - choiceText: "\u738B\u7237\u7237\u60A8\u597D\uFF0C\u6211\u662F\u82B1\u706B\u5E02\u4EBA\u6C11\u533B\u9662\u6025\u8BCA\u79D1\u7684\u9648\u4E3B\u4EFB\u3002"
    scoreGain: -5
  - choiceText: "\u738B\u7237\u7237\uFF0C\u60A8\u542C\u6211\u8BF4\uFF0C\u4E0D\u8981\u6253\u65AD\u6211\u3002"
    scoreGain: -5
  - choiceText: "\u738B\u7237\u7237\uFF0C\u60A8\u4ED4\u7EC6\u542C\u6211\u8BF4"
    scoreGain: 5
  - choiceText: "\u8FD8\u670910\u5206\u949F\u4ED6\u5C31\u8981\u6491\u4E0D\u4F4F\u4E86\uFF0C\u60C5\u51B5\u975E\u5E38\u7D27\u6025"
    scoreGain: -10
  - choiceText: "\u4ED6\u5FC5\u987B\u57283\u4E2A\u5C0F\u65F6\u5185\u8FDB\u884C\u7D27\u6025\u5F00\u9885\uFF0C\u540C\u65F6\u8FDB\u884C\u813E\u810F\u5207\u9664\u548C\u9AA8\u76C6\u56FA\u5B9A\uFF0C\u4E0D\u7136\u4ED6\u80AF\u5B9A\u6491\u4E0D\u4E0B\u53BB"
    scoreGain: 10
  - choiceText: "\u6211\u4EEC\u6025\u8BCA\u79D1\u7684\u5224\u65AD\u662F\uFF1A\u5FC5\u987B\u572840\u5206\u949F\u5185\u7D27\u6025\u5F00\u9885\uFF0C\u540C\u65F6\u8FDB\u884C\u813E\u810F\u5207\u9664\u548C\u9AA8\u76C6\u56FA\u5B9A\u3002\u5426\u5219\uFF0C\u795E\u4ED9\u4E5F\u6551\u4E0D\u56DE\u6765\u3002"
    scoreGain: 10
  - choiceText: "\u6211\u8DDF\u60A8\u8BF4\u5B9E\u8BDD\uFF0C\u6211\u5DF2\u7ECF\u5E2E\u60A8\u5B59\u5B50\u4E89\u53D6\u5230\u4E86\u8111\u5916\u79D1\u548C\u9AA8\u79D1\u7684\u53CC\u4E3B\u4EFB\u8054\u5408\u624B\u672F\uFF0C\u8FD8\u62A2\u4E0B\u4E86\u4E00\u95F4\u6025\u8BCA\u624B\u672F\u5BA4\u3002\u4F46\u73B0\u5728\u8D22\u52A1\u79D1\u5361\u4F4F\u4E86\uFF0C\u56E0\u4E3A\u4E4B\u524D\u6709\u597D\u51E0\u8D77\u60A3\u8005\u6B20\u8D39\u8DD1\u5355\uFF0C\u73B0\u5728\u6CA1\u6709\u8D39\u7528\uFF0C\u8FDE\u9EBB\u9189\u836F\u3001\u8840\u6D46\u90FD\u9886\u4E0D\u51FA\u6765\u3002"
    scoreGain: 5
  - choiceText: "\u738B\u7237\u7237\uFF0C\u6211\u73B0\u5728\u7ED9\u60A8\u4E00\u4E2A\u8D26\u53F7\uFF0C\u662F\u6211\u4EEC\u533B\u9662\u6025\u8BCA\u79D1\u7684\u7EFF\u8272\u901A\u9053\u4E13\u7528\u8D26\u6237\u3002\u60A8\u8F6C\u8D26\u5907\u6CE8\u5199\u201C\u738B\u6D69\u62A2\u6551\u8D39\u201D\uFF0C\u5230\u8D26\u540E\u6211\u4EB2\u81EA\u7B7E\u5B57\uFF0C\u5341\u5206\u949F\u5185\u9001\u624B\u672F\u5BA4\u3002\r"
    scoreGain: 5
  - choiceText: "\u9996\u5148\uFF0C\u5982\u679C\u60A8\u544A\u8BC9\u4E86\u6D69\u6D69\u7684\u7236\u6BCD\uFF0C\u4ED6\u4EEC\u53EA\u4F1A\u54ED\u54ED\u557C\u557C\u5F71\u54CD\u62A2\u6551\u3002"
    scoreGain: 5
  - choiceText: "\u9996\u5148\uFF0C\u8FD9\u4EF6\u4E8B\u4E0D\u80FD\u548C\u60A8\u7684\u4EB2\u4EBA\u4EEC\u8BF4\u3002\u738B\u7237\u7237\uFF0C\u60A8\u544A\u8BC9\u4ED6\u4EEC\uFF0C\u4ED6\u4EEC\u9664\u4E86\u54ED\u548C\u614C\uFF0C\u80FD\u505A\u4EC0\u4E48\uFF1F\u7B49\u624B\u672F\u505A\u5B8C\u518D\u901A\u77E5\uFF0C\u624D\u662F\u4E3A\u4ED6\u4EEC\u597D\u3002"
    scoreGain: 10
  - choiceText: "\u7B2C\u4E00\uFF01\u4E0D\u8BB8\u544A\u8BC9\u4F60\u513F\u5B50\uFF01\u8BF4\u4E86\u8FD9\u4E8B\u513F\u5C31\u9EC4\u4E86\u3002\u4F60\u81EA\u5DF1\u62FF\u94B1\u505A\u4E3B\u5C31\u884C\u3002"
    scoreGain: -30
  - choiceText: "\u62A5\u4E86\u6211\u4EEC\u5C31\u6551\u4E0D\u4E86\u4E86\u3002\u4F60\u81EA\u5DF1\u770B\u7740\u529E\u3002"
    scoreGain: -15
  - choiceText: "\u4E00\u62A5\u8B66\uFF0C\u75C5\u5386\u5C01\u5B58\u3001\u6D41\u7A0B\u8D70\u4E24\u4E09\u5929\u3002\u60A8\u5B59\u5B50\u9885\u5185\u538B\u80FD\u7B49\u4E24\u4E09\u5929\u5417\uFF1F\u4E0D\u8BA9\u60A8\u62A5\u8B66\uFF0C\u662F\u4E3A\u4E86\u62A2\u65F6\u95F4\u6551\u4EBA\u3002"
    scoreGain: 10
  - choiceText: "\u8B66\u5BDF\u6765\u4E86\u5C31\u8981\u8C03\u67E5\u597D\u51E0\u5929\uFF0C\u624B\u672F\u5361\u4F4F\u505A\u4E0D\u4E86\u3002\u60A8\u4E5F\u4E0D\u60F3\u8FD9\u6837\u5427\uFF1F"
    scoreGain: 5
  - choiceText: "\u5230\u4E86\u94F6\u884C\uFF0C\u67DC\u5458\u95EE\u60A8\uFF0C\u5C31\u8BF4\u7ED9\u5916\u5B59\u4E70\u623F\u4EA4\u5B9A\u91D1\u3002\u5343\u4E07\u522B\u63D0\u533B\u9662\u3001\u62A2\u6551\u3002\u94F6\u884C\u4E00\u542C\u8FD9\u4E9B\u5C31\u8981\u62A5\u8B66\u6838\u5B9E\uFF0C\u8D70\u6D41\u7A0B\u4E24\u4E09\u4E2A\u5C0F\u65F6\u3002\u60A8\u5B59\u5B50\u7B49\u4E0D\u8D77\u3002"
    scoreGain: 10
  - choiceText: "\u5728\u94F6\u884C\u8F6C\u94B1\u7684\u65F6\u5019\uFF0C\u5C31\u8BF4\u662F\u4E70\u623F\u5B50\u7684\u94B1\uFF0C\u522B\u7684\u4EC0\u4E48\u4E5F\u522B\u8BF4\u3002\u8BF4\u591A\u4E86\u9EBB\u70E6\u3002"
    scoreGain: -5
  - choiceText: "\u5230\u94F6\u884C\u540E\uFF0C\u5C31\u8BF4\u4E70\u623F\uFF0C\u4E00\u4E2A\u5B57\u90FD\u4E0D\u80FD\u591A\u8BF4\uFF01\u8BF4\u6F0F\u5634\u5B59\u5B50\u5C31\u6CA1\u4E86\uFF01"
    scoreGain: -20
  - choiceText: "\u738B\u7237\u7237\uFF0C\u6211\u518D\u544A\u8BC9\u60A8\u4E00\u4E2A\u4E8B\u2014\u2014\u60A8\u5B59\u5B50\u7684\u9885\u5185\u51FA\u8840\u8FD8\u5728\u6269\u5927\uFF0C\u6211\u7684\u540C\u4E8B\u521A\u521A\u62A5\u8FC7\u6765\uFF0C\u77B3\u5B54\u5DF2\u7ECF\u51FA\u73B0\u4E0D\u7B49\u5927\u3002\u8FD9\u662F\u8111\u759D\u524D\u5146\u3002"
    scoreGain: 10
  - choiceText: "\u6211\u6700\u591A\u518D\u7ED9\u60A8\u538B25\u5206\u949F\u300225\u5206\u949F\u5185\u94B1\u4E0D\u5230\u8D26\uFF0C\u624B\u672F\u5BA4\u5C31\u4F1A\u628A\u540D\u989D\u8BA9\u7ED9\u540E\u9762\u7684\u6025\u8BCA\u60A3\u8005\u3002"
    scoreGain: 5
  wordStops:
  - triggerText: "\u6551\u4EBA\u8981\u7D27\u554A\uFF01\u6211\u73B0\u5728\u5C31\u6765\u533B\u9662"
