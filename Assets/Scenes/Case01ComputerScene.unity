    text: "\u522B\u95EE\uFF1F\u4F60\u628A\u6211\u4ECE\u56FD\u5185\u9A97\u51FA\u6765\uFF0C\u8BF4\u662F\u4EC0\u4E48\u201C\u9AD8\u85AA\u5DE5\u4F5C\u201D\uFF0C\u7ED3\u679C\u4E00\u843D\u5730\u5C31\u88AB\u5E26\u5230\u8FD9\u79CD\u5730\u65B9\u6765\uFF01\u4F60\u5230\u5E95\u5728\u641E\u4EC0\u4E48\uFF1F\uFF01"
  - speakerName: "\u738B\u4ECE\u5FC3"
    text: "\u641E\u4EC0\u4E48\uFF1F\u4F60\u4EE5\u4E3A\u6211\u60F3\u5417\uFF1F\uFF01\u6211\u8981\u662F\u4E0D\u628A\u4F60\u5E26\u8FC7\u6765\uFF0C\u73B0\u5728\u88AB\u7ED1\u5728\u90A3\u8FB9\u7684\u5C31\u662F\u6211\u4E86\uFF01"
  - speakerName: "\u9648\u9ED8"
    text: "\u4F60\u2026\u2026\u4F60\u8BF4\u4EC0\u4E48\uFF1F"
  - speakerName: "\u738B\u4ECE\u5FC3"
    text: "\u5927\u4F84\u5B50\uFF0C\u8205\u8205\u5BF9\u4E0D\u4F4F\u4F60\u3002\u4F46\u8205\u8205\u771F\u7684\u6CA1\u529E\u6CD5\u4E86\u2026\u2026\u9AD8\u603B\u8BF4\u4E86\uFF0C\u8981\u4E48\u5E26\u4E00\u4E2A\u4EBA\u6765\uFF0C\u8981\u4E48\u62FF\u547D\u6765\u62B5\u3002\u6211\u2026\u2026\u6211\u8FD8\u6709\u8001\u5A46\u5B69\u5B50\u554A\u2026\u2026"
  - speakerName: "\u9648\u9ED8"
    text: "\u6240\u4EE5\u4F60\u5C31\u628A\u6211\u5356\u4E86\uFF1F\u6211\u662F\u4F60\u4EB2\u5916\u7525\uFF01"
  - speakerName: "\u738B\u4ECE\u5FC3"
    text: "\u884C\u4E86\uFF01\u6765\u90FD\u6765\u4E86\uFF0C\u8BF4\u8FD9\u4E9B\u8FD8\u6709\u4EC0\u4E48\u7528\uFF1F\u4E0D\u7BA1\u90A3\u4E48\u591A\u4E86\u5927\u4F84\u5B50\uFF0C\u73B0\u5728\u4F60\u9762\u5BF9\u7684\u5C31\u662F\u4F60\u7684\u7B2C\u4E00\u4EFD\u5DE5\u4F5C\u3002"
  - speakerName: "\u9648\u9ED8"
    text: "\u4EC0\u4E48\u5DE5\u4F5C\uFF1F\u6211\u4E0D\u5E72\uFF01"
  - speakerName: "\u738B\u4ECE\u5FC3"
    text: "\u4F60\u4E0D\u5E72\u4E5F\u5F97\u5E72\u3002\u542C\u597D\u4E86\u2014\u2014\u5E72\u5F97\u597D\uFF0C\u6709\u94B1\u62FF\uFF0C\u6211\u80FD\u60F3\u529E\u6CD5\u8BA9\u4F60\u6D3B\u7740\u51FA\u53BB\u3002\u5E72\u4E0D\u597D\u2026\u2026\u770B\u5230\u540E\u9762\u90A3\u4E2A\u6C34\u6C60\u5B50\u6CA1\u6709\uFF1F\u91CC\u9762\u517B\u7684\u90FD\u662F\u9CC4\u9C7C\u3002\u4F60\u4E5F\u4E0D\u60F3\u53D8\u6210\u5B83\u4EEC\u7684\u665A\u996D\u5427\uFF1F\r\n\r\n"
  - speakerName: "\u9648\u9ED8"
    text: "\u597D\uFF0C\u4F60\u597D\u5F97\u5F88\uFF01\uFF01\uFF01"
  typingSpeed: 0.03
  tutorialGuideManager: {fileID: 538073200}
