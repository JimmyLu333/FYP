  - choiceText: "\u4ECA\u5929\u4E0B\u5348\u6211\u4EEC\u5728\u62BD\u68C0\u4E2D\u53D1\u73B0\u4E00\u4E2A\u767B\u8BB0\u5728\u4F60\u540D\u4E0B\u7684\u5F02\u5E38\u5305\u88F9\uFF0C\u76EE\u524D\u5DF2\u7ECF\u89E6\u53D1\u8C03\u67E5\u7A0B\u5E8F\u3002"
    scoreGain: 10
  - choiceText: "\u6211\u4EEC\u53D1\u73B0\u4E00\u4E2A\u548C\u4F60\u4E2A\u4EBA\u4FE1\u606F\u6709\u5173\u7684\u5305\u88F9\uFF0C\u9700\u8981\u548C\u4F60\u786E\u8BA4\u4E00\u4E0B\u3002"
