  - choiceText: "\u5305\u88F9\u4E0A\u7684\u4FE1\u606F\u548C\u4F60\u7684\u8EAB\u4EFD\u9AD8\u5EA6\u543B\u5408\uFF0C\u4F60\u9700\u8981\u914D\u5408\u8BF4\u660E\u60C5\u51B5\u3002"
